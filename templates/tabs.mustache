<ul role="tablist" class="nav nav-tabs" style="list-style: outside none none">
    {{#topicstabs}}
		<li class="nav-item">
			<a class="nav-link {{active}} {{marked}} {{muted}}" data-toggle="tab" href="#section-{{num}}">
				{{#muted}}<i class="fa-regular fa-eye-slash fa-sm fa-fw" aria-hidden="true"></i>{{/muted}}
				{{#marked}}<i class="fa-solid fa-thumbtack fa-sm fa-fw" aria-hidden="true"></i>{{/marked}}
				{{name}}
			</a>
		</li>
		{{/topicstabs}}
</ul>
