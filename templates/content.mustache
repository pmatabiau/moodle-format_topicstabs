{{!
    @template format_topicstabs/content

    Course page of the Topics with tabs format (outside editing mode).
    The tabs and the tab panes are rendered here, from the sections exported by Moodle, so that
    they always match. Each section is rendered by the standard core_courseformat section template.

    Context variables required for this template:
    * title - course title
    * completionhelp - completion help
    * format - course format name (topicstabs)
    * uniqid - unique id of the page
    * sectionreturn - section number to return to
    * initialsection - general section (section 0), displayed above the tabs
    * sections - other sections, each with num and tabactive
    * hastabs, navclass, topicstabs - see format_topicstabs/tabs
}}
<div id="{{uniqid}}-course-format">
    <h2 class="accesshide">{{{title}}}</h2>
    {{{completionhelp}}}
    <div class="topicstabs-container" data-region="topicstabs" data-for="course_sectionlist">
        {{#initialsection}}
            <ul class="{{format}}">
                {{> core_courseformat/local/content/section}}
            </ul>
        {{/initialsection}}
        {{#hastabs}}
            <div class="topicstabs-navwrapper">
                {{> format_topicstabs/tabs}}
            </div>
        {{/hastabs}}
        <div class="tab-content topicstabs-content">
            {{#sections}}
                <div class="tab-pane {{#tabactive}}show active{{/tabactive}}"
                     id="topicstabs-pane-{{num}}"
                     role="tabpanel"
                     aria-labelledby="topicstabs-tab-{{num}}">
                    <ul class="{{format}}">
                        {{> core_courseformat/local/content/section}}
                    </ul>
                </div>
            {{/sections}}
        </div>
    </div>
</div>
{{#js}}
    require(['core_courseformat/local/content'], function(component) {
        component.init('{{uniqid}}-course-format', {}, {{sectionreturn}});
    });
{{/js}}
